{
  "name": "stocrant",
  "version": "1.0.0",
  "private": true,
  "description": "STOCRANT - business management for companies, locations, workforce, HR and operations.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "demo:accounts": "npm run build && node scripts/create-demo-accounts.mjs",
    "build": "tsc -p server/tsconfig.build.json",
    "build:frontend": "node ./node_modules/vite/bin/vite.js build",
    "build:full": "npm run build:frontend && npm run build",
    "dev:api": "npm run build && node dist/index.js",
    "dev:frontend": "node ./node_modules/vite/bin/vite.js",
    "dev": "node ./node_modules/concurrently/dist/bin/concurrently.js \"npm run dev:api\" \"npm run dev:frontend\"",
    "start": "npm run build:full && node dist/index.js",
    "preview:local": "npm run build:full && node scripts/start-local-preview.mjs",
    "typecheck": "tsc --noEmit -p server/tsconfig.json",
    "test": "npm run build && node --test dist/routes.test.js dist/organizations.test.js dist/documents.test.js dist/hr-communication.test.js dist/company-profile.test.js dist/payroll.test.js dist/audit.test.js dist/organization-manager.test.js dist/dashboard-upgrade.test.js dist/administration.test.js && node scripts/verify-storage.mjs",
    "admin:reset": "node scripts/reset-admin.mjs",
    "setup:reset": "node scripts/reset-first-time-setup.mjs",
    "mobile:build": "node ./node_modules/vite/bin/vite.js build && npx cap sync",
    "mobile:android": "npm run mobile:build && npx cap open android",
    "mobile:ios": "npm run mobile:build && npx cap open ios",
    "mobile:apk": "npm run mobile:build && powershell -ExecutionPolicy Bypass -File ./build-apk.ps1",
    "mobile:apk:lan": "powershell -ExecutionPolicy Bypass -File ./build-mobile-lan.ps1",
    "mobile:add:android": "npx cap add android",
    "mobile:add:ios": "npx cap add ios",
    "check:data": "node scripts/check-data.mjs",
    "check": "npm run typecheck && tsc --noEmit -p tsconfig.json && npm test && npm run test:lock && npm run test:notifications && npm run test:translations && npm run build:frontend && npm run test:production",
    "test:translations": "node --test scripts/test-translations.mjs",
    "test:production": "node scripts/verify-production.mjs",
    "test:notifications": "node --test scripts/test-notification-activity.mjs",
    "test:notification-panel": "npm run build:full && node scripts/verify-notification-panel.mjs",
    "test:hr-documents": "npm run build:full && node scripts/verify-hr-documents.mjs",
    "test:lock": "node scripts/test-app-lock.mjs",
    "test:hr-communication": "npm run build:full && node scripts/verify-hr-communication.mjs",
    "mobile:save": "node scripts/save-mobile-update.mjs",
    "test:company-profile": "npm run build:full && node scripts/verify-company-profile.mjs",
    "test:payroll": "npm run build:full && node scripts/verify-payroll.mjs",
    "mobile:icons": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/generate-mobile-app-icons.ps1",
    "test:redesign": "npm run build:full && node scripts/verify-redesign.mjs",
    "test:audit": "npm run build:full && node scripts/verify-audit.mjs",
    "test:public-website": "npm --prefix public-website run build && node scripts/verify-public-website.mjs",
    "test:complete-workspace": "npm run build:full && node scripts/verify-complete-workspace.mjs",
    "test:organization-manager": "npm run build:full && node scripts/verify-organization-manager.mjs",
    "test:dashboard-upgrade": "npm run build:full && node scripts/verify-dashboard-upgrade.mjs",
    "test:administration": "npm run build:full && node scripts/verify-administration.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "9.1.2",
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "7.1.2",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "chart.js": "4.5.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.18.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^8.2.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
