{
  "name": "stocrant",
  "version": "1.0.0",
  "private": true,
  "description": "STOCRANT - business management for companies, locations, workforce, HR and operations.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "demo:accounts": "npm run build && node scripts/create-demo-accounts.mjs",
    "build": "tsc -p server/tsconfig.build.json",
    "build:frontend": "node ./node_modules/vite/bin/vite.js build",
    "build:full": "npm run build:website && npm run build:shop && npm run build:frontend && npm run build",
    "dev:api": "npm run build && node dist/index.js",
    "dev:frontend": "node ./node_modules/vite/bin/vite.js",
    "dev": "node ./node_modules/concurrently/dist/bin/concurrently.js \"npm run dev:api\" \"npm run dev:frontend\"",
    "start": "npm run build:full && node dist/index.js",
    "preview:local": "npm run build:full && node scripts/start-local-preview.mjs",
    "typecheck": "tsc --noEmit -p server/tsconfig.json",
    "test": "npm run build && node --test dist/routes.test.js dist/organizations.test.js dist/documents.test.js dist/employment-contracts.test.js dist/hr-communication.test.js dist/company-profile.test.js dist/payroll.test.js dist/finance-flow.test.js dist/audit.test.js dist/organization-manager.test.js dist/operations.test.js dist/dashboard-upgrade.test.js dist/administration.test.js dist/self-attendance.test.js dist/notification-context.test.js dist/public-website.test.js dist/personal-notes.test.js dist/organization-admins.test.js dist/commerce.test.js dist/storefront.test.js dist/storefront-merchandising.test.js dist/security-identity.test.js dist/invitations.test.js && node scripts/verify-storage.mjs",
    "admin:reset": "node scripts/reset-admin.mjs",
    "admin:handover": "node scripts/admin-handover.mjs",
    "admin:create-super": "node scripts/create-super-admin.mjs",
    "test:admin-handover": "node --test scripts/admin-handover.test.mjs",
    "test:super-admin": "node --test scripts/create-super-admin.test.mjs",
    "setup:reset": "node scripts/reset-first-time-setup.mjs",
    "mobile:build": "node ./node_modules/vite/bin/vite.js build && npx cap sync",
    "mobile:android": "npm run mobile:build && npx cap open android",
    "mobile:ios": "npm run mobile:build && npx cap open ios",
    "mobile:apk": "npm run mobile:build && powershell -ExecutionPolicy Bypass -File ./build-apk.ps1",
    "mobile:apk:lan": "powershell -ExecutionPolicy Bypass -File ./build-mobile-lan.ps1",
    "mobile:add:android": "npx cap add android",
    "mobile:add:ios": "npx cap add ios",
    "check:data": "node scripts/check-data.mjs",
    "check": "npm run typecheck && tsc --noEmit -p tsconfig.json && npm test && npm run test:admin-handover && npm run test:super-admin && npm run test:lock && npm run test:notifications && npm run test:finance-connected && npm run test:financial-money && npm run test:translations && npm run build:website && npm run build:shop && npm run build:frontend && npm run test:production",
    "test:invitations": "npm run build:full && node scripts/verify-invitations.mjs",
    "test:translations": "node --test scripts/test-translations.mjs scripts/test-public-language.mjs scripts/test-shop-language.mjs",
    "test:production": "node scripts/verify-production.mjs",
    "test:notifications": "node --test scripts/test-notification-activity.mjs",
    "test:notification-panel": "npm run build:full && node scripts/verify-notification-panel.mjs",
    "test:hr-documents": "npm run build:full && node scripts/verify-hr-documents.mjs",
    "test:lock": "node scripts/test-app-lock.mjs",
    "test:hr-communication": "npm run build:full && node scripts/verify-hr-communication.mjs",
    "mobile:save": "node scripts/save-mobile-update.mjs",
    "test:company-profile": "npm run build:full && node scripts/verify-company-profile.mjs",
    "test:payroll": "npm run build:full && node scripts/verify-payroll.mjs",
    "mobile:icons": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/generate-mobile-app-icons.ps1",
    "test:redesign": "npm run build:full && node scripts/verify-redesign.mjs",
    "test:audit": "npm run build:full && node scripts/verify-audit.mjs",
    "test:public-website": "npm run build:full && node scripts/verify-public-website.mjs",
    "test:complete-workspace": "npm run build:full && node scripts/verify-complete-workspace.mjs",
    "test:organization-admins": "npm run build:full && node scripts/verify-organization-admins.mjs",
    "test:records-layout": "npm run build:full && node scripts/verify-records-layout.mjs",
    "test:organization-manager": "npm run build:full && node scripts/verify-organization-manager.mjs",
    "test:personal-notes": "npm run build:full && node scripts/verify-personal-notes.mjs",
    "test:dashboard-upgrade": "npm run build:full && node scripts/verify-dashboard-upgrade.mjs",
    "test:administration": "npm run build:full && node scripts/verify-administration.mjs",
    "test:work-activity": "npm run build:full && node scripts/verify-work-activity.mjs",
    "test:mobile-attendance": "npm run build:full && node scripts/verify-mobile-attendance.mjs",
    "test:mobile-layout": "npm run build:full && node scripts/verify-mobile-layout.mjs",
    "test:financial-money": "node --test scripts/test-financial-money.mjs",
    "test:operations": "npm run build:full && node scripts/verify-operations.mjs",
    "build:website": "npm --prefix public-website run build",
    "test:commerce": "npm run build:full && node scripts/verify-commerce.mjs",
    "build:shop": "node ./node_modules/typescript/bin/tsc --noEmit -p shop-website/tsconfig.json && node ./node_modules/vite/bin/vite.js build --config shop-website/vite.config.ts",
    "test:storefront": "npm run build:full && node scripts/verify-storefront.mjs",
    "test:merchandising": "npm run build:full && node scripts/verify-merchandising.mjs",
    "preview:shop": "npm run build:full && node scripts/preview-storefront.mjs",
    "test:finance-connected": "node --test scripts/test-finance-connected.mjs",
    "test:inventory": "npm run build:frontend && npm run build && node scripts/verify-inventory.mjs",
    "test:sidebar": "npm run build:frontend && npm run build && node --test scripts/test-workspace-navigation.mjs && node scripts/verify-sidebar.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "9.1.2",
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "7.1.2",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "chart.js": "4.5.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.18.4",
    "read-excel-file": "9.3.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^8.2.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
