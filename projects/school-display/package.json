{
  "name": "school-display",
  "productName": "Qatar School Time Table",
  "version": "2.2.0",
  "private": true,
  "description": "Bilingual school timetable and Windows classroom overlay",
  "author": "Qatar School Time Table",
  "license": "UNLICENSED",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server/start.mjs",
    "desktop": "node desktop/launch.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:glass": "node tests/glass-panel.mjs",
    "test:moments": "node tests/moments.mjs",
    "dist:win": "electron-builder --win nsis portable --x64",
    "check": "npm test",
    "test:adjustments": "node tests/adjustments.mjs",
    "dist:win:signed": "electron-builder --config build/signed.cjs --win nsis portable --x64",
    "test:workspace": "node tests/workspace.mjs",
    "test:remote": "node tests/remote-browser.mjs",
    "test:background": "node tests/background.mjs",
    "test:lessons": "node tests/lesson-screens.mjs"
  },
  "dependencies": {
    "sql.js": "1.15.2"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "online.schooldisplay.desktop",
    "productName": "Qatar School Time Table",
    "directories": {
      "output": "releases"
    },
    "files": [
      "desktop/**/*",
      "server/**/*",
      "shared/**/*",
      "web/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.pfx",
      "!**/*.p12",
      "!**/*.pem",
      "!**/*.key"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "Qatar-School-Time-Table-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Qatar-School-Time-Table-Portable-${version}-${arch}.${ext}"
    }
  }
}
