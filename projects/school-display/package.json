{
  "name": "school-display",
  "productName": "School Display",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual school timetable and Windows classroom overlay",
  "author": "School Display",
  "license": "UNLICENSED",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server/start.mjs",
    "desktop": "node desktop/launch.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:glass": "node tests/glass-panel.mjs",
    "dist:win": "electron-builder --win nsis portable --x64",
    "check": "npm test"
  },
  "dependencies": { "sql.js": "1.15.2" },
  "devDependencies": { "electron": "45.0.0", "electron-builder": "26.18.0" },
  "build": {
    "appId": "online.schooldisplay.desktop",
    "productName": "School Display",
    "directories": { "output": "releases" },
    "files": ["desktop/**/*", "server/**/*", "shared/**/*", "web/**/*", "assets/**/*", "package.json"],
    "asarUnpack": ["node_modules/sql.js/dist/*.wasm"],
    "win": { "icon": "assets/icon.ico", "target": ["nsis", "portable"], "signExecutable": false },
    "nsis": { "artifactName": "School-Display-Setup-${version}-${arch}.${ext}", "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "deleteAppDataOnUninstall": false },
    "portable": { "artifactName": "School-Display-Portable-${version}-${arch}.${ext}" }
  }
}
