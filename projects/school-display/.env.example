# Example only: set these as process/service environment variables.
# Leave network/update variables unset for the normal local Windows application.
# SCHOOL_NETWORK_ORIGIN=https://school.example.edu:8443
# SCHOOL_BIND_HOST=0.0.0.0
# SCHOOL_TLS_CERT=C:/SchoolDisplay/private/fullchain.pem
# SCHOOL_TLS_KEY=C:/SchoolDisplay/private/server.key
# SCHOOL_DATA_DIR=C:/SchoolDisplay/data
# SCHOOL_UPDATE_URL=https://updates.example.edu/school-display/latest.json
# SCHOOL_UPDATE_SIGNER=<40-character Authenticode certificate thumbprint>
# Set WIN_CSC_LINK and WIN_CSC_KEY_PASSWORD only in your signing provider/CI secrets.
