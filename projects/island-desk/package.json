{
  "name": "island-desk",
  "productName": "Island Desk",
  "version": "0.9.0",
  "description": "A quiet, offline workspace floating above your desktop.",
  "author": "Island Desk",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "start": "npm run build && node scripts/launch.mjs",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/tests/*.test.js",
    "test:desktop": "npm run build && node scripts/smoke.mjs",
    "package:win": "npm run build && electron-builder --win nsis portable",
    "package:dir": "npm run build && electron-builder --dir",
    "icons": "node scripts/make-icons.mjs",
    "launcher:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-launcher-apk.ps1",
    "flutter:check": "node scripts/flutter.mjs check",
    "flutter:windows": "node scripts/flutter.mjs windows",
    "flutter:android": "node scripts/flutter.mjs android",
    "flutter:run": "node scripts/flutter.mjs run",
    "mobile:save": "node scripts/save-mobile.mjs"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "7.6.9",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "@types/node": "^24.0.14",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.2.3",
    "electron-builder": "^26.0.12",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "studio.islanddesk.desktop",
    "productName": "Island Desk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/@capacitor/**"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Island-Desk-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Island-Desk-Portable-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "electron/media.ps1",
        "to": "media.ps1"
      },
      {
        "from": "electron/stats.ps1",
        "to": "stats.ps1"
      }
    ]
  }
}
