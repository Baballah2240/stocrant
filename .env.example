# STOCRANT environment variables.
# Copy to .env (git-ignored) or set them in your process manager / hosting panel.
# The server does not load .env itself; export them in the shell or service config.

# HTTP port for the API and the built frontend (default: 3000).
PORT=3000

# Optional independently hosted marketing site. Defaults to /website/ on this
# workspace server. Public build-time value, also used by the native app.
#VITE_PUBLIC_WEBSITE_URL=https://your-public-website.example

# Calendar day used for attendance. Set the business's IANA timezone.
STOCRANT_TIME_ZONE=Asia/Qatar
# Set to 1 on local/staging pilot servers to block all attendance salary deductions,
# including companies whose saved attendance policy previously enabled them.
#STOCRANT_ATTENDANCE_PILOT=1
# Optional public contact details; inquiries are stored in the main-admin inbox.
#STOCRANT_CONTACT_EMAIL=
#STOCRANT_CONTACT_PHONE=
# Additional trusted browser origins for a separately hosted frontend.
#STOCRANT_ALLOWED_ORIGINS=https://your-frontend.example
# Only enable when running behind one trusted reverse proxy (e.g. Render).
#STOCRANT_TRUST_PROXY=1

# Base directory; runtime data is written to <STOCRANT_DATA_DIR>/data/stocrant.json.
# Defaults to the application root when unset. On a persistent disk, point this
# at the mounted volume (e.g. /var/lib/stocrant).
#STOCRANT_DATA_DIR=

# Private HR attachments use <STOCRANT_DATA_DIR>/data/private-documents.
# Back up this directory TOGETHER with data/stocrant.json. JSON-only daily
# snapshots do not copy attachment bytes. Never expose the data directory.
# Default upload limit: 10 MiB; hard ceiling: 25 MiB per file.
#STOCRANT_DOCUMENT_MAX_BYTES=10485760
#STOCRANT_DOCUMENT_TYPES=pdf,doc,docx,xls,xlsx,jpg,jpeg,png
# Default reminder period; individual documents can override (1–365 days).
#STOCRANT_DOCUMENT_WARNING_DAYS=30

# REQUIRED in production (NODE_ENV=production): long random HMAC secret used to
# sign session cookies. Generation example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
STOCRANT_SESSION_SECRET=replace-with-a-long-random-secret

# REQUIRED before the first production account is created: one-time key for the
# initial Main Manager setup. After setup it is no longer used for sign-in.
# Omit in development: the fallback key is "local-setup".
STOCRANT_SETUP_KEY=replace-with-a-private-setup-key
# Optional employee onboarding email (Resend). Configure a verified sender/domain.
# These are server-only variables; never prefix them with VITE_.
STOCRANT_EMAIL_API_KEY=
STOCRANT_EMAIL_FROM=
STOCRANT_APP_URL=
# 32-byte base64 AES key. Keep stable across restarts; store outside source control.
STOCRANT_ONBOARDING_KEY=

# Optional shop subdomain bindings, after configuring DNS/TLS on the hosting service.
# Example: amal.mohbaba.online=amal. Never bind the workspace hostname here.
STOCRANT_SHOP_HOSTS=

# Number of daily data snapshots kept in <data>/backups (default: 30).
#STOCRANT_BACKUP_DAYS=30

# Android push (optional). Absolute path to a private Firebase service account JSON.
# Mount it as a hosting secret file; never commit it or copy it into the mobile app.
STOCRANT_FCM_SERVICE_ACCOUNT_FILE=
